<https://purl.org/wmthompson/mfg>
    a owl:Ontology ;
    owl:versionIRI <https://purl.org/wmthompson/mfg/1.0.0> ;
    owl:imports <https://purl.org/wmthompson/quality> ,
                <https://purl.org/wmthompson/finance> .


@prefix mfg:     <https://purl.org/wmthompson/mfg#> .
@prefix quality: <https://purl.org/wmthompson/quality#> .
@prefix finance: <https://purl.org/wmthompson/finance#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://purl.org/wmthompson/mfg>
    a                owl:Ontology ;
    dcterms:title    "Manufacturing Domain Ontology" ;
    dcterms:description
        "OWL DL ontology for manufacturing planning and execution: items, BOMs, routing, work orders, planned order receipts, production events, and lead-time offsets." ;
    dcterms:creator  "wmthompson1" ;
    dcterms:created  "2026-10-21"^^xsd:date ;
    dcterms:license  <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI   <https://purl.org/wmthompson/mfg/1.0.0> ;
    owl:imports      <https://purl.org/wmthompson/quality> ,
                     <https://purl.org/wmthompson/finance> .

### OBJECT PROPERTIES (NO rdfs:domain)
mfg:hasBOM a owl:ObjectProperty ;
    rdfs:label "has bill of material" ;
    rdfs:comment "Associates an Item with its Bill of Material definition." ;
    rdfs:range mfg:BOM .

mfg:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component" ;
    rdfs:comment "Links a BOM to one of its component Items." ;
    rdfs:range mfg:Item .

mfg:hasRoutingStep a owl:ObjectProperty ;
    rdfs:label "has routing step" ;
    rdfs:comment "Associates a WorkOrder or BOM with an ordered RoutingStep." ;
    rdfs:range mfg:RoutingStep .

mfg:hasLeadTimeOffset a owl:ObjectProperty ;
    rdfs:label "has lead-time offset" ;
    rdfs:comment "Associates a planning entity with a LeadTimeOffset." ;
    rdfs:range mfg:LeadTimeOffset .

mfg:producesItem a owl:ObjectProperty ;
    rdfs:label "produces item" ;
    rdfs:comment "The Item produced by a WorkOrder or PlannedOrderReceipt." ;
    rdfs:range mfg:Item .

mfg:fulfilledBy a owl:ObjectProperty ;
    rdfs:label "fulfilled by" ;
    rdfs:comment "Links a PlannedOrderReceipt to the WorkOrder that satisfies it." ;
    rdfs:range mfg:WorkOrder .

mfg:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by" ;
    rdfs:comment "Links a ProductionEvent to the WorkOrder that caused it." ;
    rdfs:range mfg:WorkOrder .

mfg:recordedAt a owl:ObjectProperty ;
    rdfs:label "recorded at routing step" ;
    rdfs:comment "The RoutingStep at which a ProductionEvent was recorded." ;
    rdfs:range mfg:RoutingStep .

mfg:precedesStep a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "precedes step" ;
    rdfs:comment "Ordering relation between RoutingSteps." ;
    rdfs:range mfg:RoutingStep .

mfg:hasQualityEvent a owl:ObjectProperty ;
    rdfs:label "has quality event" ;
    rdfs:comment "Links a ProductionEvent to associated QualityEvent(s)." ;
    rdfs:range quality:QualityEvent .

mfg:hasInventoryValue a owl:ObjectProperty ;
    rdfs:label "has inventory value" ;
    rdfs:comment "Associates an Item with its InventoryValue record." ;
    rdfs:range finance:InventoryValue .

mfg:hasWIPValue a owl:ObjectProperty ;
    rdfs:label "has WIP value" ;
    rdfs:comment "Associates a WorkOrder with its WIPValue record." ;
    rdfs:range finance:WIPValue .

### DATATYPE PROPERTIES (NO rdfs:domain)
mfg:itemNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string .

mfg:itemDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string .

mfg:leadTimeDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

mfg:offsetDays a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer .

mfg:plannedStartDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:date .

mfg:plannedEndDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:date .

mfg:plannedQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

mfg:workOrderNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string .

mfg:stepDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string .

mfg:runTimeHours a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

mfg:eventTimestamp a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:dateTime .

mfg:eventType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string .

mfg:quantityReported a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:decimal .

mfg:bomRevision a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string .

mfg:bomEffectiveDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:date .

mfg:stepSequence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:integer .

mfg:workOrderStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:string .

### CLASSES WITH LOCAL RESTRICTIONS (OWL DL SAFE)
mfg:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A discrete part, component, sub-assembly, or finished good." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:itemNumber ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:itemDescription ; owl:minCardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:leadTimeDays ; owl:maxCardinality 1 ] .

mfg:BOM a owl:Class ;
    rdfs:label "Bill of Material" ;
    rdfs:comment "Versioned list of components required to produce a parent Item." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:bomRevision ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:bomEffectiveDate ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:hasComponent ; owl:minCardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:hasComponent ; owl:allValuesFrom mfg:Item ] .

mfg:RoutingStep a owl:Class ;
    rdfs:label "Routing Step" ;
    rdfs:comment "An operation in the manufacturing routing." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:stepSequence ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:stepDescription ; owl:minCardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:runTimeHours ; owl:maxCardinality 1 ] .

mfg:LeadTimeOffset a owl:Class ;
    rdfs:label "Lead-Time Offset" ;
    rdfs:comment "A signed day-offset applied to planned dates." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:offsetDays ; owl:cardinality 1 ] .

mfg:WorkOrder a owl:Class ;
    rdfs:label "Work Order" ;
    rdfs:comment "A manufacturing order authorizing production of an Item." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:workOrderNumber ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:workOrderStatus ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:producesItem ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:producesItem ; owl:allValuesFrom mfg:Item ] ,
        [ a owl:Restriction ; owl:onProperty mfg:plannedStartDate ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:plannedEndDate ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:plannedQuantity ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:hasRoutingStep ; owl:minCardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:hasRoutingStep ; owl:allValuesFrom mfg:RoutingStep ] .

mfg:PlannedOrderReceipt a owl:Class ;
    rdfs:label "Planned Order Receipt" ;
    rdfs:comment "An MRP-generated supply recommendation." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:producesItem ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:producesItem ; owl:allValuesFrom mfg:Item ] ,
        [ a owl:Restriction ; owl:onProperty mfg:plannedQuantity ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:plannedEndDate ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:fulfilledBy ; owl:maxCardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:fulfilledBy ; owl:allValuesFrom mfg:WorkOrder ] .

mfg:ProductionEvent a owl:Class ;
    rdfs:label "Production Event" ;
    rdfs:comment "A timestamped shop-floor occurrence associated with a WorkOrder and RoutingStep." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mfg:eventTimestamp ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:eventType ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:triggeredBy ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:triggeredBy ; owl:allValuesFrom mfg:WorkOrder ] ,
        [ a owl:Restriction ; owl:onProperty mfg:recordedAt ; owl:cardinality 1 ] ,
        [ a owl:Restriction ; owl:onProperty mfg:recordedAt ; owl:allValuesFrom mfg:RoutingStep ] ,
        [ a owl:Restriction ; owl:onProperty mfg:quantityReported ; owl:maxCardinality 1 ] .
