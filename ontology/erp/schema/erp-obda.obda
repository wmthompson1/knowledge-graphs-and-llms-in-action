			:accountBudgetSum_nBudgetCrAmount {N_BUDGET_CR_AMOUNT}^^xsd:decimal ;
			:accountBudgetSum_flag {FLAG}^^xsd:integer .
source		SELECT SPID, ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, BUDGET_TYPE, BUDGET_CODE, CURRENCY_ID, ROWID, O_BUDGET_DR_AMOUNT, O_BUDGET_CR_AMOUNT, N_BUDGET_DR_AMOUNT, N_BUDGET_CR_AMOUNT, FLAG FROM dbo.ACCOUNT_BUDGET_SUM

mappingId	M_AccountChgLog
target		:AccountChgLog/{TRANSACTION_ID} a :AccountChgLog ;
			:accountChgLog_rowid {ROWID}^^xsd:integer ;
			:accountChgLog_transactionId {TRANSACTION_ID}^^xsd:integer ;
			:accountChgLog_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountChgLog_createDate {CREATE_DATE}^^xsd:dateTime ;
			:accountChgLog_fromType {FROM_TYPE}^^xsd:string ;
			:accountChgLog_toType {TO_TYPE}^^xsd:string ;
			:accountChgLog_userId {USER_ID}^^xsd:string ;
			:accountChgLog_account :Account/{ACCOUNT_ID} .
source		SELECT TRANSACTION_ID, ROWID, ACCOUNT_ID, CREATE_DATE, FROM_TYPE, TO_TYPE, USER_ID FROM dbo.ACCOUNT_CHG_LOG

mappingId	M_AccountGroup
target		:AccountGroup/{GROUP_ID}/{ACCOUNT_ID} a :AccountGroup ;
			:accountGroup_rowid {ROWID}^^xsd:integer ;
			:accountGroup_groupId {GROUP_ID}^^xsd:string ;
			:accountGroup_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountGroup_addAssetExpense {ADD_ASSET_EXPENSE}^^xsd:integer ;
			:accountGroup_account :Account/{ACCOUNT_ID} .
source		SELECT GROUP_ID, ACCOUNT_ID, ROWID, ADD_ASSET_EXPENSE FROM dbo.ACCOUNT_GROUP

mappingId	M_AccountPeriod
target		:AccountPeriod/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD} a :AccountPeriod ;
			:accountPeriod_rowid {ROWID}^^xsd:integer ;
			:accountPeriod_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountPeriod_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountPeriod_status {STATUS}^^xsd:string ;
			:accountPeriod_beginDate {BEGIN_DATE}^^xsd:dateTime ;
			:accountPeriod_endDate {END_DATE}^^xsd:dateTime ;
			:accountPeriod_statusEffDate {STATUS_EFF_DATE}^^xsd:dateTime ;
			:accountPeriod_siteId {SITE_ID}^^xsd:string ;
			:accountPeriod_calendarId {CALENDAR_ID}^^xsd:string ;
			:accountPeriod_lockMfg {LOCK_MFG}^^xsd:string ;
			:accountPeriod_lockAr {LOCK_AR}^^xsd:string ;
			:accountPeriod_lockAp {LOCK_AP}^^xsd:string ;
			:accountPeriod_lockGj {LOCK_GJ}^^xsd:string .
source		SELECT SITE_ID, ACCT_YEAR, ACCT_PERIOD, ROWID, STATUS, BEGIN_DATE, END_DATE, STATUS_EFF_DATE, CALENDAR_ID, LOCK_MFG, LOCK_AR, LOCK_AP, LOCK_GJ FROM dbo.ACCOUNT_PERIOD

mappingId	M_AccountProfile
target		:AccountProfile/{ACCOUNT_TYPE}/{PROFILE_ID}/{PROFILE_TYPE}/{ACCOUNT_ID} a :AccountProfile ;
			:accountProfile_rowid {ROWID}^^xsd:integer ;
			:accountProfile_accountType {ACCOUNT_TYPE}^^xsd:string ;
