			:accountingEntity_vatEnabled {VAT_ENABLED}^^xsd:string ;
			:accountingEntity_vatDiscounted {VAT_DISCOUNTED}^^xsd:string ;
			:accountingEntity_vatRegistration {VAT_REGISTRATION}^^xsd:string ;
			:accountingEntity_vatPaybExportId {VAT_PAYB_EXPORT_ID}^^xsd:string ;
			:accountingEntity_vatRecvExportId {VAT_RECV_EXPORT_ID}^^xsd:string ;
			:accountingEntity_vatCategoryReqd {VAT_CATEGORY_REQD}^^xsd:string ;
			:accountingEntity_vatOnFreight {VAT_ON_FREIGHT}^^xsd:string ;
