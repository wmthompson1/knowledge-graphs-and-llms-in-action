			:accountingEntity_whCertifExptId {WH_CERTIF_EXPT_ID}^^xsd:string ;
			:accountingEntity_whSummaryExptId {WH_SUMMARY_EXPT_ID}^^xsd:string ;
			:accountingEntity_nextWithholdSeq {NEXT_WITHHOLD_SEQ}^^xsd:integer ;
			:accountingEntity_cashPercentVar {CASH_PERCENT_VAR}^^xsd:string ;
			:accountingEntity_cashMinVar {CASH_MIN_VAR}^^xsd:decimal ;
			:accountingEntity_cashMaxVar {CASH_MAX_VAR}^^xsd:decimal ;
			:accountingEntity_commissionSupport {COMMISSION_SUPPORT}^^xsd:string ;
			:accountingEntity_commPaymentMeth {COMM_PAYMENT_METH}^^xsd:string ;
			:accountingEntity_socialSecurityNo {SOCIAL_SECURITY_NO}^^xsd:string ;
			:accountingEntity_wipvasEnabled {WIPVAS_ENABLED}^^xsd:string ;
			:accountingEntity_ddpEnabled {DDP_ENABLED}^^xsd:string ;
			:accountingEntity_autoAllocate {AUTO_ALLOCATE}^^xsd:string ;
			:accountingEntity_coAllocLevel {CO_ALLOC_LEVEL}^^xsd:string ;
			:accountingEntity_reqAllocLevel {REQ_ALLOC_LEVEL}^^xsd:string ;
			:accountingEntity_defShipWeightUm {DEF_SHIP_WEIGHT_UM}^^xsd:string ;
			:accountingEntity_backordFillRate {BACKORD_FILL_RATE}^^xsd:decimal ;
			:accountingEntity_projBurdenRule {PROJ_BURDEN_RULE}^^xsd:string ;
			:accountingEntity_reqApp1Label {REQ_APP1_LABEL}^^xsd:string ;
			:accountingEntity_reqApp2Label {REQ_APP2_LABEL}^^xsd:string ;
			:accountingEntity_reqApp3Label {REQ_APP3_LABEL}^^xsd:string ;
			:accountingEntity_reqApp4Label {REQ_APP4_LABEL}^^xsd:string ;
			:accountingEntity_reqGenAllTasks {REQ_GEN_ALL_TASKS}^^xsd:string ;
			:accountingEntity_reqCmntPwdReq {REQ_CMNT_PWD_REQ}^^xsd:string ;
			:accountingEntity_calendarId {CALENDAR_ID}^^xsd:string ;
			:accountingEntity_defCashMgtBankAr {DEF_CASH_MGT_BANK_AR}^^xsd:string ;
			:accountingEntity_defCashMgtBankAp {DEF_CASH_MGT_BANK_AP}^^xsd:string ;
			:accountingEntity_custBalInclType {CUST_BAL_INCL_TYPE}^^xsd:string ;
			:accountingEntity_finBatchSingleTrans {FIN_BATCH_SINGLE_TRANS}^^xsd:string ;
			:accountingEntity_country :Country/{COUNTRY_ID} ;
			:accountingEntity_financialCalendar :FinancialCalendar/{CALENDAR_ID} .
source		SELECT ID, ROWID, ENTITY_NAME, ENTITY_ADDR_1, ENTITY_ADDR_2, ENTITY_ADDR_3, ENTITY_CITY, ENTITY_STATE, ENTITY_ZIPCODE, ENTITY_COUNTRY, ENTITY_COUNTRY_ID, STATUS, TAX_ID_NUMBER, DEF_LANGUAGE_ID, FUNCTIONAL_CURRENCY_ID, XCHG_RATE_DATE, XCHG_RATE_DEF_RCPT, COSTING_INTERLEVEL, COSTING_METHOD, COSTING_SOURCE, COSTING_STD_LABOR, COSTING_WIP_METHOD, COST_BY_TRACE_ID, BURDEN_SOURCE, FIFO_BY_LOCATION, EARNED_REV_METHOD, VAT_ENABLED, VAT_DISCOUNTED, VAT_REGISTRATION, VAT_PAYB_EXPORT_ID, VAT_RECV_EXPORT_ID, VAT_CATEGORY_REQD, VAT_ON_FREIGHT, NEXT_VAT_SEQ, VAT_FILE_PREFIX, VAT_FILE_ZEROS, VAT_FILE_PLACES, VAT_BOOK_NUM_GEN, INTRASTAT_ENABLED, VERIFY_INTRASTAT, COUNTRY_ID, BRANCH_ID, NEXT_INTRASTAT_SEQ, INTRA_FILE_PREFIX, INTRA_FILE_ZEROS, INTRA_FILE_PLACES, INTRASTAT_FREQ, INTRA_ARRV_EXPT_ID, INTRA_DISP_EXPT_ID, NEXT_ESL_SEQ, ESL_FILE_PREFIX, ESL_FILE_ZEROS, ESL_FILE_PLACES, ESL_FREQ, ESL_EXPORT_ID, A_SHOW_COUNTRY, A_SHOW_EXCISE_PR, A_SHOW_PORT_ARRVL, A_SHOW_PORT_TRANS, A_SHOW_REGION, A_SHOW_SIRET_NO, A_SHOW_TARIFF_CODE, D_SHOW_COUNTRY, D_SHOW_EXCISE_PR, D_SHOW_PORT_ARRVL, D_SHOW_PORT_TRANS, D_SHOW_REGION, D_SHOW_SIRET_NO, D_SHOW_TARIFF_CODE, NEXT_PAY_BATCH_SEQ, PAY_FILE_PREFIX, PAY_FILE_ZEROS, PAY_FILE_PLACES, WITHHOLD_ENABLED, WH_CERTIF_EXPT_ID, WH_SUMMARY_EXPT_ID, NEXT_WITHHOLD_SEQ, CASH_PERCENT_VAR, CASH_MIN_VAR, CASH_MAX_VAR, COMMISSION_SUPPORT, COMM_PAYMENT_METH, SOCIAL_SECURITY_NO, WIPVAS_ENABLED, DDP_ENABLED, AUTO_ALLOCATE, CO_ALLOC_LEVEL, REQ_ALLOC_LEVEL, DEF_SHIP_WEIGHT_UM, BACKORD_FILL_RATE, PROJ_BURDEN_RULE, REQ_APP1_LABEL, REQ_APP2_LABEL, REQ_APP3_LABEL, REQ_APP4_LABEL, REQ_GEN_ALL_TASKS, REQ_CMNT_PWD_REQ, CALENDAR_ID, DEF_CASH_MGT_BANK_AR, DEF_CASH_MGT_BANK_AP, CUST_BAL_INCL_TYPE, FIN_BATCH_SINGLE_TRANS FROM dbo.ACCOUNTING_ENTITY

mappingId	M_AccountAtNative
target		:AccountAtNative/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{CURRENCY_ID} a :AccountAtNative ;
			:accountAtNative_rowid {ROWID}^^xsd:integer ;
			:accountAtNative_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountAtNative_siteId {SITE_ID}^^xsd:string ;
			:accountAtNative_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountAtNative_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountAtNative_debitAmount {DEBIT_AMOUNT}^^xsd:decimal ;
			:accountAtNative_creditAmount {CREDIT_AMOUNT}^^xsd:decimal ;
			:accountAtNative_currencyId {CURRENCY_ID}^^xsd:string ;
			:accountAtNative_currency :Currency/{CURRENCY_ID} .
source		SELECT ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, CURRENCY_ID, ROWID, DEBIT_AMOUNT, CREDIT_AMOUNT FROM dbo.ACCOUNT_AT_NATIVE

mappingId	M_AccountBalance
target		:AccountBalance/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{CURRENCY_ID} a :AccountBalance ;
			:accountBalance_rowid {ROWID}^^xsd:integer ;
			:accountBalance_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountBalance_siteId {SITE_ID}^^xsd:string ;
			:accountBalance_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountBalance_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountBalance_debitAmount {DEBIT_AMOUNT}^^xsd:decimal ;
			:accountBalance_creditAmount {CREDIT_AMOUNT}^^xsd:decimal ;
			:accountBalance_debitBudget {DEBIT_BUDGET}^^xsd:decimal ;
			:accountBalance_creditBudget {CREDIT_BUDGET}^^xsd:decimal ;
			:accountBalance_flag {FLAG}^^xsd:integer ;
			:accountBalance_currencyId {CURRENCY_ID}^^xsd:string ;
			:accountBalance_currBalance {CURR_BALANCE}^^xsd:decimal ;
			:accountBalance_soaBalSent {SOA_BAL_SENT}^^xsd:string ;
			:accountBalance_site :Site/{SITE_ID} ;
			:accountBalance_currency :Currency/{CURRENCY_ID} .
source		SELECT ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, CURRENCY_ID, ROWID, DEBIT_AMOUNT, CREDIT_AMOUNT, DEBIT_BUDGET, CREDIT_BUDGET, FLAG, CURR_BALANCE, SOA_BAL_SENT FROM dbo.ACCOUNT_BALANCE

mappingId	M_AccountBalDim
target		:AccountBalDim/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{CURRENCY_ID}/{USER_DIMENSION_1}/{USER_DIMENSION_2}/{CUST_ORDER_ID}/{PRODUCT_CODE} a :AccountBalDim ;
			:accountBalDim_rowid {ROWID}^^xsd:integer ;
			:accountBalDim_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountBalDim_siteId {SITE_ID}^^xsd:string ;
			:accountBalDim_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountBalDim_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountBalDim_currencyId {CURRENCY_ID}^^xsd:string ;
			:accountBalDim_userDimension1 {USER_DIMENSION_1}^^xsd:string ;
			:accountBalDim_userDimension2 {USER_DIMENSION_2}^^xsd:string ;
			:accountBalDim_custOrderId {CUST_ORDER_ID}^^xsd:string ;
			:accountBalDim_productCode {PRODUCT_CODE}^^xsd:string ;
			:accountBalDim_debitAmount {DEBIT_AMOUNT}^^xsd:decimal ;
			:accountBalDim_creditAmount {CREDIT_AMOUNT}^^xsd:decimal ;
			:accountBalDim_flag {FLAG}^^xsd:integer ;
			:accountBalDim_currBalance {CURR_BALANCE}^^xsd:decimal ;
			:accountBalDim_currency :Currency/{CURRENCY_ID} ;
			:accountBalDim_site :Site/{SITE_ID} .
source		SELECT ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, CURRENCY_ID, USER_DIMENSION_1, USER_DIMENSION_2, CUST_ORDER_ID, PRODUCT_CODE, ROWID, DEBIT_AMOUNT, CREDIT_AMOUNT, FLAG, CURR_BALANCE FROM dbo.ACCOUNT_BAL_DIM

mappingId	M_AccountBalSum
target		:AccountBalSum/{SPID}/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{CURRENCY_ID} a :AccountBalSum ;
			:accountBalSum_rowid {ROWID}^^xsd:integer ;
			:accountBalSum_spid {SPID}^^xsd:string ;
			:accountBalSum_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountBalSum_siteId {SITE_ID}^^xsd:string ;
			:accountBalSum_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountBalSum_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountBalSum_oDebitAmount {O_DEBIT_AMOUNT}^^xsd:decimal ;
			:accountBalSum_oCreditAmount {O_CREDIT_AMOUNT}^^xsd:decimal ;
			:accountBalSum_oDebitBudget {O_DEBIT_BUDGET}^^xsd:decimal ;
			:accountBalSum_oCreditBudget {O_CREDIT_BUDGET}^^xsd:decimal ;
			:accountBalSum_nDebitAmount {N_DEBIT_AMOUNT}^^xsd:decimal ;
			:accountBalSum_nCreditAmount {N_CREDIT_AMOUNT}^^xsd:decimal ;
			:accountBalSum_nDebitBudget {N_DEBIT_BUDGET}^^xsd:decimal ;
			:accountBalSum_nCreditBudget {N_CREDIT_BUDGET}^^xsd:decimal ;
			:accountBalSum_flag {FLAG}^^xsd:integer ;
			:accountBalSum_currencyId {CURRENCY_ID}^^xsd:string .
source		SELECT SPID, ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, CURRENCY_ID, ROWID, O_DEBIT_AMOUNT, O_CREDIT_AMOUNT, O_DEBIT_BUDGET, O_CREDIT_BUDGET, N_DEBIT_AMOUNT, N_CREDIT_AMOUNT, N_DEBIT_BUDGET, N_CREDIT_BUDGET, FLAG FROM dbo.ACCOUNT_BAL_SUM

mappingId	M_AccountBudget
target		:AccountBudget/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{BUDGET_TYPE}/{BUDGET_CODE}/{CURRENCY_ID} a :AccountBudget ;
			:accountBudget_rowid {ROWID}^^xsd:integer ;
			:accountBudget_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountBudget_siteId {SITE_ID}^^xsd:string ;
			:accountBudget_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountBudget_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountBudget_budgetType {BUDGET_TYPE}^^xsd:string ;
			:accountBudget_budgetCode {BUDGET_CODE}^^xsd:string ;
			:accountBudget_currencyId {CURRENCY_ID}^^xsd:string ;
			:accountBudget_budgetDrAmount {BUDGET_DR_AMOUNT}^^xsd:decimal ;
			:accountBudget_budgetCrAmount {BUDGET_CR_AMOUNT}^^xsd:decimal ;
			:accountBudget_flag {FLAG}^^xsd:integer ;
			:accountBudget_account :Account/{ACCOUNT_ID} ;
			:accountBudget_site :Site/{SITE_ID} ;
			:accountBudget_budgetType_budgetType :BudgetType/{BUDGET_TYPE} ;
			:accountBudget_budgetCode_budgetCode :BudgetCode/{BUDGET_CODE} ;
			:accountBudget_currency :Currency/{CURRENCY_ID} .
source		SELECT ACCOUNT_ID, SITE_ID, ACCT_YEAR, ACCT_PERIOD, BUDGET_TYPE, BUDGET_CODE, CURRENCY_ID, ROWID, BUDGET_DR_AMOUNT, BUDGET_CR_AMOUNT, FLAG FROM dbo.ACCOUNT_BUDGET

mappingId	M_AccountBudgetSum
target		:AccountBudgetSum/{SPID}/{ACCOUNT_ID}/{SITE_ID}/{ACCT_YEAR}/{ACCT_PERIOD}/{BUDGET_TYPE}/{BUDGET_CODE}/{CURRENCY_ID} a :AccountBudgetSum ;
			:accountBudgetSum_rowid {ROWID}^^xsd:integer ;
			:accountBudgetSum_spid {SPID}^^xsd:string ;
			:accountBudgetSum_accountId {ACCOUNT_ID}^^xsd:string ;
			:accountBudgetSum_siteId {SITE_ID}^^xsd:string ;
			:accountBudgetSum_acctYear {ACCT_YEAR}^^xsd:decimal ;
			:accountBudgetSum_acctPeriod {ACCT_PERIOD}^^xsd:decimal ;
			:accountBudgetSum_budgetType {BUDGET_TYPE}^^xsd:string ;
			:accountBudgetSum_budgetCode {BUDGET_CODE}^^xsd:string ;
			:accountBudgetSum_currencyId {CURRENCY_ID}^^xsd:string ;
			:accountBudgetSum_oBudgetDrAmount {O_BUDGET_DR_AMOUNT}^^xsd:decimal ;
			:accountBudgetSum_oBudgetCrAmount {O_BUDGET_CR_AMOUNT}^^xsd:decimal ;
