			:accountingEntity_eslFileZeros {ESL_FILE_ZEROS}^^xsd:string ;
			:accountingEntity_eslFilePlaces {ESL_FILE_PLACES}^^xsd:integer ;
			:accountingEntity_eslFreq {ESL_FREQ}^^xsd:string ;
			:accountingEntity_eslExportId {ESL_EXPORT_ID}^^xsd:string ;
			:accountingEntity_aShowCountry {A_SHOW_COUNTRY}^^xsd:string ;
			:accountingEntity_aShowExcisePr {A_SHOW_EXCISE_PR}^^xsd:string ;
			:accountingEntity_aShowPortArrvl {A_SHOW_PORT_ARRVL}^^xsd:string ;
			:accountingEntity_aShowPortTrans {A_SHOW_PORT_TRANS}^^xsd:string ;
			:accountingEntity_aShowRegion {A_SHOW_REGION}^^xsd:string ;
			:accountingEntity_aShowSiretNo {A_SHOW_SIRET_NO}^^xsd:string ;
			:accountingEntity_aShowTariffCode {A_SHOW_TARIFF_CODE}^^xsd:string ;
			:accountingEntity_dShowCountry {D_SHOW_COUNTRY}^^xsd:string ;
			:accountingEntity_dShowExcisePr {D_SHOW_EXCISE_PR}^^xsd:string ;
			:accountingEntity_dShowPortArrvl {D_SHOW_PORT_ARRVL}^^xsd:string ;
			:accountingEntity_dShowPortTrans {D_SHOW_PORT_TRANS}^^xsd:string ;
			:accountingEntity_dShowRegion {D_SHOW_REGION}^^xsd:string ;
			:accountingEntity_dShowSiretNo {D_SHOW_SIRET_NO}^^xsd:string ;
			:accountingEntity_dShowTariffCode {D_SHOW_TARIFF_CODE}^^xsd:string ;
			:accountingEntity_nextPayBatchSeq {NEXT_PAY_BATCH_SEQ}^^xsd:integer ;
			:accountingEntity_payFilePrefix {PAY_FILE_PREFIX}^^xsd:string ;
			:accountingEntity_payFileZeros {PAY_FILE_ZEROS}^^xsd:string ;
			:accountingEntity_payFilePlaces {PAY_FILE_PLACES}^^xsd:integer ;
