[PrefixDeclaration]
:	http://example.com/erp#
xsd:	http://www.w3.org/2001/XMLSchema#
rdfs:	http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[

mappingId	M_Account
target		:Account/{ID} a :Account ;
			:account_rowid {ROWID}^^xsd:integer ;
			:account_id {ID}^^xsd:string ;
			:account_description {DESCRIPTION}^^xsd:string ;
			:account_type {TYPE}^^xsd:string ;
			:account_summaryAccount {SUMMARY_ACCOUNT}^^xsd:string ;
			:account_parentAcctId {PARENT_ACCT_ID}^^xsd:string ;
			:account_currencyId {CURRENCY_ID}^^xsd:string ;
			:account_revalue {REVALUE}^^xsd:string ;
			:account_projectAccount {PROJECT_ACCOUNT}^^xsd:string ;
			:account_activeFlag {ACTIVE_FLAG}^^xsd:string ;
			:account_statusEffDate {STATUS_EFF_DATE}^^xsd:dateTime ;
			:account_currency :Currency/{CURRENCY_ID} .
source		SELECT ID, ROWID, DESCRIPTION, TYPE, SUMMARY_ACCOUNT, PARENT_ACCT_ID, CURRENCY_ID, REVALUE, PROJECT_ACCOUNT, ACTIVE_FLAG, STATUS_EFF_DATE FROM dbo.ACCOUNT

mappingId	M_AccountingEntity
target		:AccountingEntity/{ID} a :AccountingEntity ;
			:accountingEntity_rowid {ROWID}^^xsd:integer ;
