@prefix mfg:   <https://wmthompson1.github.io/create-context-graph/mfg#> .
@prefix mfgm:  <https://wmthompson1.github.io/create-context-graph/mfgm#> .
@prefix mfgq:  <https://wmthompson1.github.io/create-context-graph/mfgq#> .
@prefix sapo:  <https://sap-ontology.deloitte.com/schema#> .
@prefix salt:  <https://wmthompson1.github.io/create-context-graph/salt#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

mfg: a owl:Ontology ;
    rdfs:label "Unified Manufacturing + Quality Ontology"@en ;
    rdfs:comment "Combines manufacturing and quality semantics and imports the planning semantics vocabulary."@en ;
    owl:imports <https://wmthompson1.github.io/create-context-graph/ontology/mfg/planning-semantics.ttl> .

#################################################################
# Unified Manufacturing + Quality Ontology
# Combines mfgm + mfgq into a single Deloitte-aligned domain.
#################################################################

#################################################################
# Manufacturing Classes
#################################################################

mfg:WorkOrder a owl:Class ;
    rdfs:label "Work Order" ;
    rdfs:comment "Manufacturing work order representing a production instance." ;
    sapo:mapsToDomain sapo:ProcessInstance .

mfg:PlannedOrderReceipt a owl:Class ;
    rdfs:label "Planned Order Receipt" ;
    rdfs:comment "A planned material receipt candidate that can be near-term but not necessarily firm." .

mfg:PlannedOrderRelease a owl:Class ;
    rdfs:label "Planned Order Release" ;
    rdfs:comment "The planning release information associated with a planned order receipt." .

mfg:LeadTimeOffset a owl:Class ;
    rdfs:label "Lead Time Offset" ;
    rdfs:comment "Planning offset used to determine whether a receipt falls within the demand fence." .

mfg:DemandFence a owl:Class ;
    rdfs:label "Demand Fence" ;
    rdfs:comment "Boundary within which a planned order can be near-term but still not firm." .

mfg:Part a owl:Class ;
    rdfs:label "Part" ;
    rdfs:comment "Manufactured or purchased part." ;
    sapo:mapsToDomain sapo:MasterData .

mfg:BillOfMaterials a owl:Class ;
    rdfs:label "Bill of Materials" ;
    rdfs:comment "Structured component hierarchy for a manufactured part." ;
    sapo:mapsToDomain sapo:DataObject .

mfg:MaterialRequirement a owl:Class ;
    rdfs:label "Material Requirement" ;
    rdfs:comment "Material requirement for a work order or production step." ;
    sapo:mapsToDomain sapo:Input .

mfg:WorkCenter a owl:Class ;
    rdfs:label "Work Center" ;
    rdfs:comment "Manufacturing resource node or production center." ;
    sapo:mapsToDomain sapo:SystemComponent .

mfg:ProductionEvent a owl:Class ;
    rdfs:label "Production Event" ;
    rdfs:comment "Execution event occurring during manufacturing." ;
    sapo:mapsToDomain sapo:Event .

#################################################################
# Quality Classes
#################################################################

mfg:Inspection a owl:Class ;
    rdfs:label "Inspection" ;
    rdfs:comment "Quality inspection activity." ;
    sapo:mapsToDomain sapo:Activity .

mfg:QualityEvent a owl:Class ;
    rdfs:label "Quality Event" ;
    rdfs:comment "Event representing a quality deviation or inspection result." ;
    sapo:mapsToDomain sapo:Event .

mfg:NonConformanceReport a owl:Class ;
    rdfs:label "Non-Conformance Report" ;
    rdfs:comment "Formal record of a quality deviation." ;
    sapo:mapsToDomain sapo:Issue .

mfg:Defect a owl:Class ;
    rdfs:label "Defect" ;
    rdfs:comment "Observed defect during inspection or production." ;
    sapo:mapsToDomain sapo:Finding .

mfg:CorrectiveAction a owl:Class ;
    rdfs:label "Corrective Action" ;
    rdfs:comment "Action taken to remediate a quality issue." ;
    sapo:mapsToDomain sapo:Remediation .

mfg:RootCause a owl:Class ;
    rdfs:label "Root Cause" ;
    rdfs:comment "Root cause analysis result for a quality deviation." ;
    sapo:mapsToDomain sapo:Cause .

#################################################################
# Cross-Domain Bindings (Manufacturing ↔ Quality)
#################################################################

mfg:QualityEvent mfg:affectsPart mfg:Part ;
    rdfs:comment "Quality event affecting a manufactured part." .

mfg:QualityEvent mfg:associatedWithOrder mfg:WorkOrder ;
    rdfs:comment "Quality event associated with a manufacturing work order." .

mfg:Inspection mfg:inspectsPart mfg:Part ;
    rdfs:comment "Inspection performed on a part." .

mfg:NonConformanceReport mfg:associatedWithInspection mfg:Inspection ;
    rdfs:comment "NCR linked to an inspection." .

mfg:CorrectiveAction mfg:addressesDefect mfg:Defect ;
    rdfs:comment "Corrective action addressing a defect." .

mfg:RootCause mfg:explainsDefect mfg:Defect ;
    rdfs:comment "Root cause explaining a defect." .

#################################################################
# Unified Properties
#################################################################

mfg:hasEvent a owl:ObjectProperty ;
    rdfs:label "has event" ;
    rdfs:range mfg:ProductionEvent .

mfg:hasQualityEvent a owl:ObjectProperty ;
    rdfs:label "has quality event" ;
    rdfs:range mfg:QualityEvent .

mfg:hasInspection a owl:ObjectProperty ;
    rdfs:label "has inspection" ;
    rdfs:range mfg:Inspection .

mfg:hasNCR a owl:ObjectProperty ;
    rdfs:label "has NCR" ;
    rdfs:range mfg:NonConformanceReport .

mfg:forItem a owl:ObjectProperty ;
    rdfs:label "for item" ;
    rdfs:range mfg:Part .

mfg:offsetByLeadTime a owl:ObjectProperty ;
    rdfs:label "offset by lead time" ;
    rdfs:range mfg:LeadTimeOffset .

mfg:hasDemandFence a owl:ObjectProperty ;
    rdfs:label "has demand fence" ;
    rdfs:range mfg:DemandFence .

mfg:isInsideDemandFence a owl:DatatypeProperty ;
    rdfs:label "is inside demand fence" ;
    rdfs:range xsd:boolean .

mfg:isFirm a owl:DatatypeProperty ;
    rdfs:label "is firm" ;
    rdfs:range xsd:boolean .

mfg:leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "lead time days" ;
    rdfs:range xsd:integer .

mfg:eligibleForExceptionMessage a owl:ObjectProperty ;
    rdfs:label "eligible for exception message" ;
    rdfs:range mfg:MRPExceptionMessage .

mfg:hasMRPExceptionTable a owl:ObjectProperty ;
    rdfs:label "has MRP exception table" ;
    rdfs:range mfg:MRPExceptionTable .

mfg:releaseDateMayBeAdjustedByMRP a owl:DatatypeProperty ;
    rdfs:label "release date may be adjusted by MRP" ;
    rdfs:range xsd:boolean .

mfg:releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date" ;
    rdfs:range xsd:dateTime .

mfg:MRPExceptionMessage a owl:Class ;
    rdfs:label "MRP exception message" ;
    rdfs:comment "Semantically eligible exception message class; actual message generation is operationally handled by MRP." .

mfg:MRPExceptionTable a owl:Class ;
    rdfs:label "MRP exception table" ;
    rdfs:comment "Operational table that records exception messages generated by the MRP engine for planned order receipts." .

mfg:RescheduleOutSuggestion a owl:Class ;
    rdfs:label "Reschedule out suggestion" ;
    rdfs:subClassOf mfg:MRPExceptionMessage .

mfg:WorkOrder rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasEvent ;
      owl:allValuesFrom mfg:ProductionEvent
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasQualityEvent ;
      owl:allValuesFrom mfg:QualityEvent
    ] .

mfg:Part rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasInspection ;
      owl:allValuesFrom mfg:Inspection
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasNCR ;
      owl:allValuesFrom mfg:NonConformanceReport
    ] .

mfg:PlannedOrderReceipt rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:forItem ;
      owl:allValuesFrom mfg:Part
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:offsetByLeadTime ;
      owl:allValuesFrom mfg:LeadTimeOffset
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasDemandFence ;
      owl:allValuesFrom mfg:DemandFence
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:isInsideDemandFence ;
      owl:allValuesFrom xsd:boolean
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:isFirm ;
      owl:allValuesFrom xsd:boolean
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:eligibleForExceptionMessage ;
      owl:allValuesFrom mfg:MRPExceptionMessage
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:hasMRPExceptionTable ;
      owl:allValuesFrom mfg:MRPExceptionTable
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:releaseDateMayBeAdjustedByMRP ;
      owl:allValuesFrom xsd:boolean
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:releaseDate ;
      owl:allValuesFrom xsd:dateTime
    ] .

mfg:PlannedOrderRelease rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:releaseDate ;
      owl:allValuesFrom xsd:dateTime
    ] .

mfg:DemandFence rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:forItem ;
      owl:allValuesFrom mfg:Part
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty mfg:leadTimeDays ;
      owl:allValuesFrom xsd:integer
    ] .

#################################################################
# Deloitte Alignment Hooks
#################################################################

mfg:mapsToSAPO a owl:ObjectProperty ;
    rdfs:label "maps to Deloitte SAP Ontology" ;
    rdfs:comment "Used to align unified manufacturing + quality classes to Deloitte sap-ontology domains." .
